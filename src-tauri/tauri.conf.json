{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topluyo",
  "version": "1.0.0",
  "identifier": "com.topluyo.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Topluyo",
        "url": "https://topluyo.com",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "BURAYA_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/KULLANICI/REPO/releases/latest/download/latest.json"
      ]
    }
  }
}
